# 复制本文件为 .env 并填入你的密钥；.env 不会被提交到版本库。
# 已存在的系统环境变量优先级更高，不会被 .env 覆盖。

# 必填：deepseek API 密钥
DEEPSEEK_API_KEY=

# 可选：模型名（默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：接口地址（默认官方；可指向兼容 OpenAI 的自建/代理网关）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# ---- 下载增强（遇到 403 Forbidden 时配置）----
# 从浏览器读取 Cookie（最有效的 403 解法）。填浏览器名，可带 profile：
#   chrome / edge / firefox / brave / chromium，或 chrome:Default
# 注意：读取时需先关闭该浏览器，否则可能因数据库被占用而失败。
# YTDLP_COOKIES_FROM_BROWSER=chrome

# 或使用导出的 cookies.txt（Netscape 格式）文件路径
# YTDLP_COOKIES_FILE=D:/path/to/cookies.txt

# 可选：指定 player client（逗号分隔），部分场景可绕开风控
# YTDLP_PLAYER_CLIENT=web_safari,android,tv
